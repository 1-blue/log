{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "application_analysis"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "analysisJobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "jobPosting": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "snapshotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "source": {
          "type": "string",
          "enum": [
            "wanted"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      },
      "required": [
        "id",
        "snapshotId",
        "source",
        "url",
        "title",
        "companyName",
        "contentHash",
        "text"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "resume": {
          "type": "object",
          "properties": {
            "versionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80100
            },
            "originalLength": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "versionId",
            "contentHash",
            "text",
            "originalLength",
            "truncated"
          ],
          "additionalProperties": false
        },
        "portfolio": {
          "type": "object",
          "properties": {
            "versionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80100
            },
            "originalLength": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "versionId",
            "contentHash",
            "text",
            "originalLength",
            "truncated"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "resume",
        "portfolio"
      ],
      "additionalProperties": false
    },
    "callbacks": {
      "type": "object",
      "properties": {
        "eventPath": {
          "type": "string",
          "pattern": "^\\/v1\\/internal\\/analysis-jobs\\/[0-9a-f-]+\\/events$"
        },
        "resultPath": {
          "type": "string",
          "pattern": "^\\/v1\\/internal\\/analysis-jobs\\/[0-9a-f-]+\\/result$"
        }
      },
      "required": [
        "eventPath",
        "resultPath"
      ],
      "additionalProperties": false
    },
    "outputSchemas": {
      "type": "object",
      "properties": {
        "jobPostingFacts": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "profileComparison": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "jobPostingFacts",
        "profileComparison"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "eventId",
    "requestId",
    "analysisJobId",
    "jobPosting",
    "profile",
    "callbacks",
    "outputSchemas"
  ],
  "additionalProperties": false
}
