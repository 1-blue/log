# 공개 변수: 블로그의 canonical URL과 절대 URL 생성에 사용하는 서비스 기본 주소입니다.
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# 공개 변수: 브라우저가 연결할 Supabase 프로젝트의 API URL입니다.
NEXT_PUBLIC_SUPABASE_URL=

# 공개 변수: 브라우저의 Supabase Auth 요청에 사용하는 sb_publishable 형식의 키입니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 공개 변수: 관리자 화면이 호출할 Cloudflare Worker API의 기본 주소입니다.
NEXT_PUBLIC_WORKER_API_URL=
