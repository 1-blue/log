# 비밀 변수: n8n Credentials를 암호화하며 최초 설정 후 변경하면 기존 Credentials를 읽을 수 없습니다.
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS

# 비밀 변수: n8n 전용 PostgreSQL 계정의 비밀번호이며 Compose가 DB와 n8n 연결에 함께 사용합니다.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD

# 환경별 변수: Slack 공고 알림에서 관리자 화면 링크를 생성할 Next.js 서비스 기본 주소입니다.
APP_BASE_URL=http://localhost:3000

# 환경별 변수: Docker 내부의 n8n이 진행 상태와 결과를 반환할 Worker 내부 API 기본 주소입니다.
WORKER_CALLBACK_URL=http://host.docker.internal:8787/v1/internal

# 비밀 변수: n8n이 Worker callback 요청에 생성하는 HMAC 서명 키이며 Worker의 N8N_CALLBACK_SECRET과 같습니다.
WORKER_CALLBACK_SECRET=REPLACE_WITH_RANDOM_CALLBACK_SECRET

# 비밀 변수: Worker가 n8n Webhook 요청에 생성한 HMAC 서명을 검증하며 Worker의 N8N_WEBHOOK_SECRET과 같습니다.
WORKER_TO_N8N_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# 환경별 변수: 공고별 루트 메시지를 생성할 Slack 공고 채널의 Channel ID입니다.
SLACK_JOB_CHANNEL_ID=C_REPLACE_ME

# 비밀 변수: Worker와 n8n의 시스템 오류를 전송할 Slack 에러 채널의 Incoming Webhook URL입니다.
SLACK_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/ERROR_SECRET
