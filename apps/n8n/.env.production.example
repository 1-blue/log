# 서버의 /opt/career-ops-n8n/.env에만 보관하고 chmod 600을 적용합니다.
# 실제 값은 저장소 또는 GitHub Actions에 복사하지 않습니다.
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
# N8N_PUBLIC_URL은 trailing slash 없이 입력합니다.
N8N_DOMAIN=n8n.nintory.com
N8N_PUBLIC_URL=https://n8n.nintory.com
APP_BASE_URL=https://blog.nintory.com
WORKER_CALLBACK_URL=https://worker.nintory.com/v1/internal
WORKER_CALLBACK_SECRET=REPLACE_WITH_RANDOM_CALLBACK_SECRET
WORKER_TO_N8N_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
SLACK_JOB_CHANNEL_ID=C_REPLACE_ME
SLACK_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/ERROR_SECRET
# caddy hash-password 출력 전체를 작은따옴표로 감싸 .env의 $ 확장을 막습니다.
CADDY_BASIC_AUTH_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
