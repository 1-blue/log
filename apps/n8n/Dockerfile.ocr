FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS pdf-runtime
WORKDIR /opt/career-ops-pdf
RUN corepack enable && corepack prepare pnpm@10.4.1 --activate
COPY ocr-runtime/package.json ocr-runtime/pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile --ignore-workspace

FROM docker.n8n.io/n8nio/n8n:2.38.7@sha256:a8c95f75c6fdf65f5f2b7a7b354744eaa1c62bb911b5c00af6499c3f38e4cd32
COPY --from=pdf-runtime --chown=node:node /opt/career-ops-pdf /opt/career-ops-pdf
COPY --chown=node:node custom-nodes/ /opt/career-ops-pdf/custom-nodes/
COPY --chown=node:node scripts/document-ocr.mjs /opt/career-ops-pdf/document-ocr.mjs
