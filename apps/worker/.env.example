# 환경별 변수: 허용 Origin 검증과 Slack 관리자 링크에 사용할 Next.js 서비스 기본 주소입니다.
APP_BASE_URL=http://localhost:3000

# 환경별 변수: Worker가 DB API에 연결하고 JWT 검증용 JWKS 주소를 조합할 Supabase 프로젝트 URL입니다.
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co

# 비밀 변수: Worker의 서버 전용 DB 작업에 사용하는 sb_secret 형식의 키이며 브라우저에 노출하면 안 됩니다.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# 비밀 취급 변수: 관리자 접근을 허용할 유일한 Supabase Auth 사용자 UUID입니다.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# 비밀 취급 변수: Worker가 분석 작업을 전달할 n8n production Webhook URL이며 로컬 Wrangler에서는 localhost를 사용합니다.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/career-analysis

# 비밀 변수: Worker가 n8n 요청에 생성하는 HMAC 서명을 검증하기 위한 공유 키입니다.
N8N_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# 비밀 변수: n8n이 Worker 내부 callback 요청에 생성하는 HMAC 서명을 검증하는 공유 키입니다.
N8N_CALLBACK_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

# 비밀 변수: Worker가 n8n dispatch 실패를 시스템 에러 채널에 알릴 Slack Incoming Webhook URL입니다.
SLACK_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/ERROR_SECRET
