{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
