# 일반 변수: CI가 Cloudflare Worker를 배포할 대상 계정의 식별자입니다.
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID

# 비밀 변수: CI에서 Worker를 배포할 최소 권한 Cloudflare API token입니다.
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN

# 비밀 변수: CI 또는 Supabase CLI가 프로젝트 migration을 관리할 때 사용하는 개인 access token입니다.
SUPABASE_ACCESS_TOKEN=REPLACE_WITH_SUPABASE_ACCESS_TOKEN

# 일반 변수: CI 또는 Supabase CLI가 migration을 적용할 원격 프로젝트 ref입니다.
SUPABASE_PROJECT_REF=REPLACE_WITH_SUPABASE_PROJECT_REF

# 비밀 변수: CI 또는 Supabase CLI가 원격 PostgreSQL에 연결할 데이터베이스 비밀번호입니다.
SUPABASE_DB_PASSWORD=REPLACE_WITH_SUPABASE_DATABASE_PASSWORD
